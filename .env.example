# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key - MUST be changed in production to a long random string
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite (for development/testing):
DATABASE_URL=sqlite:///./sentinex.db

# PostgreSQL (for production):
# DATABASE_URL=postgresql://username:password@localhost:5432/sentinex

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application environment: development, staging, or production
APP_ENV=development

# Application debug mode (set to false in production)
DEBUG=true

# ============================================================================
# OPTIONAL: AUDIT LOGGING
# ============================================================================
# Enable audit logging
AUDIT_LOGGING_ENABLED=true

# ============================================================================
# OPTIONAL: CORS CONFIGURATION
# ============================================================================
# Comma-separated list of allowed origins
# CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# OPTIONAL: LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

DATASET_ROOT=./datasets
MAX_IMAGE_SIZE_BYTES=10485760
MAX_IMAGE_DIMENSION=10000
# MODULE 4 LIVE CCTV STREAMING
STREAMING_ENABLED=true
STREAM_ENCRYPTION_KEY=
STREAM_DEFAULT_SAMPLE_FPS=1.0
STREAM_DEFAULT_QUEUE_SIZE=8
STREAM_RETRY_LIMIT=3
STREAM_RETRY_BACKOFF_SECONDS=2.0
STREAM_HEALTH_INTERVAL_SECONDS=5.0

# ============================================================================
# MODULE 5: AI VIDEO PROCESSING
# ============================================================================

# ---- Detection thresholds ----
# Minimum person-detection confidence (0.0–1.0). Lower = more detections, more false positives.
PERSON_DETECTION_THRESHOLD=0.45

# Minimum face-detection confidence (0.0–1.0). Lower = more faces detected, more false positives.
FACE_DETECTION_THRESHOLD=0.70

# ---- Tracking ----
# Maximum number of consecutive unmatched frames before a track is purged.
MAX_TRACK_AGE=30

# Minimum IoU overlap to match a new detection to an existing track.
IOU_ASSIGNMENT_THRESHOLD=0.30

# ---- Frame filtering ----
# Frames smaller than these dimensions will be rejected.
MIN_FRAME_WIDTH=64
MIN_FRAME_HEIGHT=64

# Minimum person bounding-box pixel area (width * height). Smaller = rejected.
MIN_PERSON_BBOX_AREA=1024

# ---- Candidate emission ----
# How many frames must pass between successive candidate emissions for the same track.
CANDIDATE_EMIT_INTERVAL=5

# ---- Model paths ----
# Leave empty to use auto-downloaded defaults (yolov8n.pt, MTCNN).
PERSON_MODEL_PATH=
FACE_MODEL_PATH=

# ---- Hardware ----
# "auto" selects CUDA if available, otherwise CPU.
# Explicit options: "cpu", "cuda", "cuda:0", "cuda:1"
DEVICE=auto

# ---- Persistence ----
# Write a row to processing_events table for each processed frame.
PROCESSING_EVENTS_ENABLED=true

# ============================================================================
# MODULE 12: ADMIN, BACKUP & DEPLOYMENT
# ============================================================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
WORKER_CONCURRENCY=4
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
EVIDENCE_ROOT=./evidence_store
PORT=8000
HOST=0.0.0.0

